{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saas-foundry.local/schemas/agent-audit-report.schema.json",
  "title": "SaaS Foundry Agent Audit Report",
  "type": "object",
  "required": ["schema_version", "mode", "summary", "findings", "limitations"],
  "properties": {
    "schema_version": { "const": "0.5" },
    "mode": { "const": "audit" },
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "severity", "confidence", "title", "evidence", "impact", "recommendation", "verification", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "category": { "enum": ["security", "correctness", "reliability", "performance", "testing", "maintainability", "observability", "architecture"] },
          "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
          "confidence": { "enum": ["high", "medium", "low"] },
          "title": { "type": "string" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path"],
              "properties": {
                "path": { "type": "string" },
                "line_start": { "type": "integer", "minimum": 1 },
                "line_end": { "type": "integer", "minimum": 1 },
                "excerpt": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "impact": { "type": "string" },
          "recommendation": { "type": "string" },
          "verification": { "type": "string" },
          "status": { "const": "needs_review" }
        },
        "additionalProperties": false
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "generated_at": { "type": "string", "format": "date-time" },
    "agent": { "enum": ["claude", "codex"] },
    "repository": { "type": "string" },
    "snapshot": {
      "type": "object",
      "properties": {
        "copied_files": { "type": "integer" },
        "copied_bytes": { "type": "integer" },
        "skipped_paths": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "mode": { "const": "sanitized-static-read-only" },
        "commands_run": { "const": false },
        "files_modified": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
